{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova900",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ed02ccfb-9adc-4796-a2a7-05035fa75b8e","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6da4e0bdb68d4df1b672cdf619ad6f5b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
